# Supabase — the service-role key is server-only and must never be exposed to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin area. ADMIN_PASSCODE is what you type to get in; SESSION_SECRET signs the resulting cookie
# (any long random string — `openssl rand -hex 32`).
ADMIN_PASSCODE=change-me
SESSION_SECRET=change-me-to-a-long-random-string

# Debug mode. Off in production unless this is set; available in development automatically. Even
# when allowed it still needs an admin session and the signed debug cookie, armed from /admin/debug.
# ENABLE_DEBUG_MODE=true
